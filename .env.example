# VPro Deployment Environment Variables
# Copy this file to .env and fill in the values before deploying

# PostgreSQL connection (standard PG env vars)
PGHOST=db
PGPORT=5432
PGDATABASE=becmaster

# App-specific role credentials
VPRO_PG_GUEST_USER=vpro_default
VPRO_PG_ADMIN_USER=vpro_admin
VPRO_PG_ADMIN_PASSWORD=<your-admin-pg-password>

# Database Credentials (used by docker-compose to initialize PostgreSQL)
POSTGRES_DB=becmaster
POSTGRES_USER=vpro_admin
POSTGRES_PASSWORD=<your-admin-pg-password>

# Optional DuckDB path overrides (defaults to data/*.duckdb)
# VPRO_MAIN_DB=data/vpro.duckdb
# VPRO_LISTS_DB=data/vpro_lists.duckdb
# VPRO_METADATA_DB=data/vpro_metadata.duckdb
# VPRO_USER_DB=data/vpro_user.duckdb
# VPRO_MESSAGES_DB=data/vpro_messages.duckdb
