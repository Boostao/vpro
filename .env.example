# VPro Deployment Environment Variables
# Copy this file to .env and fill in the values before deploying

# Shiny App Configuration
# Options: production, development, test
R_CONFIG_ACTIVE=production

# Database Credentials (used by docker-compose and the app logic)
# Note: POSTGRES_PASSWORD is required
POSTGRES_DB=becmaster
POSTGRES_USER=vpro_admin
POSTGRES_PASSWORD=your_secure_password_here

# Connection Details for the App to reach the 'db' service in Docker
# These correspond to the settings in config.yml
PGHOST=db
PGPORT=5432
PGDATABASE=becmaster
PGUSER=vpro_admin
PGPASSWORD=your_secure_password_here

# Full connection URL (optional, for tools that prefer a single string)
DATABASE_URL=postgresql://vpro_admin:your_secure_password_here@db:5432/becmaster
