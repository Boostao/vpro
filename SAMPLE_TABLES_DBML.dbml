// ============================================================================
// VEGETATION PROFILE & SPECIES REFERENCE TABLES
// ============================================================================

Table Sample_Profile {
  _order bigint
  _table varchar
  field varchar
  _operator varchar
  layer varchar
  species varchar [pk, note: "Species code/identifier"]
  criteria varchar
  operation varchar
  plotcount bigint
  
  note: "Reference profiles for species and layers"
}

Table SampleVeg_Profile {
  _order bigint
  _table varchar
  field varchar
  _operator varchar
  layer varchar
  species varchar
  criteria bigint
  operation varchar
  plotcount bigint
  
  note: "Operational vegetation profile data"
}

// ============================================================================
// LOOKUP / MAPPING TABLES
// ============================================================================

Table Sample_Lump {
  lumpcode varchar [pk, note: "Lumped group code"]
  sppcode varchar [note: "Individual species in group"]
  _use bigint
  
  note: "Species lumping/aggregation codes - maps to Sample_Theme"
}

Table Sample_Theme {
  lumpcode varchar
  sppcode varchar [pk, note: "Species code/identifier"]
  scientificname varchar
  colourcode bigint
  patterncode bigint
  fontcolour bigint
  _use bigint
  
  note: "Species theme and classification with lumping codes"
}

// ============================================================================
// AUDIT TABLE
// ============================================================================

Table Sample_Audit {
  id bigint [pk]
  project varchar
  _user varchar
  plotnumber varchar
  _table varchar
  editfield varchar
  editwhen varchar
  beforeedit varchar
  afteredit varchar
  restore bigint
  flag bigint
  
  note: "Audit log of all edits across all Sample_ tables"
}

// ============================================================================
// RELATIONSHIPS
// ============================================================================

// Plot-centric hub relationships
Ref: Sample_Admin.plot < Sample_Env.plotnumber
Ref: Sample_Env.plotnumber < Sample_Humus.plotnumber
Ref: Sample_Env.plotnumber < Sample_Mineral.plotnumber
Ref: Sample_Env.plotnumber < Sample_Other.plotnumber
Ref: Sample_Env.plotnumber < Sample_Veg.plotnumber
Ref: Sample_Env.plotnumber < Sample_Herbarium.plotnumber
Ref: Sample_Env.plotnumber < Sample_SU.plotnumber

// Project/Metadata relationships
Ref: Sample_Env.projectid < Sample_Metadata.projectid

// Vegetation/Species relationships
Ref: Sample_Veg.species < Sample_Herbarium.species
Ref: Sample_Veg.species < Sample_Profile.species
Ref: Sample_Profile.species < SampleVeg_Profile.species

// Lookup table relationships
Ref: Sample_Lump.sppcode < Sample_Theme.sppcode

// Record-level relationships
Ref: Sample_Metadata.id < Sample_Hierarchy.id
Ref: Sample_Metadata.id < Sample_Humus.id
Ref: Sample_Metadata.id < Sample_Mineral.id
Ref: Sample_Metadata.id < Sample_Other.id
Ref: Sample_Metadata.id < Sample_Veg.id
