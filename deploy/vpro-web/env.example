# VPro 2.0 Read-Only Web Server Environment Configuration
# Copy to .env on the DigitalOcean Droplet (e.g. /opt/vpro-web/.env) and replace
# all placeholder values before running `docker compose up -d`.
#
# Host directory bootstrap (run once on the Droplet):
#   sudo mkdir -p /srv/vpro/data/releases /srv/vpro/pmtiles /srv/vpro/pictures
#   sudo chown -R 10001:10001 /srv/vpro

# ------------------------------------------------------------------------------
# Deployment Environment & Domain
# ------------------------------------------------------------------------------
# Environment label: "dev" or "prod"
VPRO_ENV=dev

# Public FQDN served by Caddy with automatic Let's Encrypt HTTPS + HTTP/3.
#   dev placeholder:  becmaster-dev.example.com
#   prod placeholder: becmaster.example.com
VPRO_DOMAIN=becmaster-dev.example.com

# Container image published by .github/workflows/web-deploy.yml to GHCR.
#   dev:  ghcr.io/boostao/vpro/vpro-web:dev
#   prod: ghcr.io/boostao/vpro/vpro-web:web-v0.1.0   (pin immutable tag in prod!)
VPRO_IMAGE=ghcr.io/boostao/vpro/vpro-web:dev

# ------------------------------------------------------------------------------
# Read-Only Snapshot, PMTiles, and Picture Host Paths
# ------------------------------------------------------------------------------
# Current immutable snapshot bundle symlink (managed atomically by sync-snapshot.sh)
VPRO_DATA_DIR=/srv/vpro/data/current

# Parent snapshot root holding releases/<snapshotId> and relative symlink `current`
VPRO_DATA_ROOT=/srv/vpro/data

# Container-internal data path read by vpro-web:
#   /srv/vpro/data/current -> enables zero-downtime live reload after sync-snapshot.sh flips symlink
#   /data                  -> use only if VPRO_DATA_DIR points directly to a standalone bundle directory
VPRO_WEB_DATA_DIR=/srv/vpro/data/current

# Optional local PMTiles archive directory mounted read-only at /pmtiles
VPRO_PMTILES_DIR=/srv/vpro/pmtiles

# Optional CDN/Spaces base URL for PMTiles archives (leave empty to serve from /pmtiles)
# Example: https://becmaster-tiles.nyc3.cdn.digitaloceanspaces.com/pmtiles
VPRO_PMTILES_CDN_BASE_URL=

# Optional plot pictures directory mounted read-only at /pictures
VPRO_PICTURES_DIR=/srv/vpro/pictures

# ------------------------------------------------------------------------------
# Container Resource Limits & Loopback Control Port
# ------------------------------------------------------------------------------
# Memory limit for vpro-web container:
#   dev  (2-4 GB Droplet): 2g
#   prod (4-8 GB Droplet): 4g
VPRO_MEM_LIMIT=2g

# CPU quota for vpro-web container:
#   dev  (2 vCPU Droplet): 1.5
#   prod (4 vCPU Droplet): 3.0
VPRO_CPUS=1.5

# Host loopback port mapped to container internal reload endpoint (127.0.0.1 only)
VPRO_INTERNAL_PORT=9090

# ------------------------------------------------------------------------------
# Concurrency & Cache Controls (sized for ~4-5 concurrent BEC ecologists)
# ------------------------------------------------------------------------------
# Max concurrent out-of-process R/Quarto/climr/vegclust jobs
VPRO_WEB_R_CONCURRENCY=2

# Max concurrent spreadsheet/GeoPackage/RDS/PDF export jobs
VPRO_WEB_EXPORT_CONCURRENCY=3

# Bounded in-memory response/summary cache budget in MiB
VPRO_WEB_CACHE_MAX_MB=256
