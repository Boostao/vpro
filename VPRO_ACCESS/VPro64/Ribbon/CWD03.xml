<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui">
  <ribbon startFromScratch="false">
    <officeMenu>
      <button idMso="FileCompactAndRepairDatabase" insertBeforeMso="FileCloseDatabase" />
      <button idMso="FileOpenDatabase" visible="false" />
      <button idMso="FileNewDatabase" visible="false" />
      <splitButton idMso="FileSaveAsMenuAccess" visible="false" />
    </officeMenu>
    <tabs>
      <tab id="tabMain" label="CWD">
        <group id="grpProjects" label="Projects and Tools">
          <splitButton id="sb01" size="large">
            <button id="sb01btn" label="Data Entry" imageMso="ViewNormalViewPowerPoint" onAction="Sb01OnAction" />
            <menu id="sb01Menu" itemSize="large">
              <button id="sb01btn02" label="Data Entry FS882" description="This is the data form that most closely resembles the FS882 field forms." getImage="Sb01CallGetImage" onAction="Sb01OnAction" />
              <button id="sb01btn03" label="Data Entry Two Page" description="With this form FS882 data is divided into two pages." getImage="Sb01CallGetImage" onAction="Sb01OnAction"></button>
            </menu>
          </splitButton>
          <button id="cmdHome" label="Main Menu Form" onAction="Ribbon.OpenMainMenu" size="large" imageMso="OpenStartPage" supertip="Opens the main menu form." screentip="Screen tip" />
          <button id="cmdNewProject" label="New Project" imageMso="GoToNewRecord" size="large" onAction="Ribbon.NewProject" />
          <button id="cmdMergeProject" label="Merge Projects" imageMso="SharePointListsWorkOffline" size="large" onAction="Ribbon.MergeProjects" />
          <button id="cmdFormColours" label="Form Colours" imageMso="AppointmentColorDialog" size="large" onAction="Ribbon.FormColours" />
          <button id="cmdShowAbout" label="About SIVI" imageMso="BevelTextGallery" size="large" onAction="Ribbon.OpenAbout" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>