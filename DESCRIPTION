Package: vpro
Title: Quantitative Ecology and Companion SDK for VPro
Version: 2.0.0
Date: 2026-11-12
Authors@R: c(
    person("Will", "MacKenzie", , "Will.MacKenzie@GEMS1.gov.bc.ca", role = c("cre", "aut")),
